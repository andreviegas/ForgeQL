{
  "suite": "config_parity",
  "description": "Config-format parity: comment rows, block groups and key_path for text formats. Cases carrying 'enforcement': 'expect_fail' pin behaviour that does not exist yet; the expect_fail count is this campaign's progress meter and the finish line is 0. Pins are of two kinds. OBSERVED: the current result was read live from the frozen corpus, so the case fails today for exactly the reason stated. DESIGN: block rows and key_path do not exist at all yet, so the expected shape is a commitment written into this file rather than a reading of anything. Every error-shaped expect_fail case (an unknown WHERE field is a hard error, not zero rows) has a hard twin running the same query minus the not-yet-existing clause, because expect_fail accepts ANY error and would otherwise pass just as happily on a typo.",
  "cases": [
    {
      "name": "yaml_banner_comment_row_is_addressable",
      "use": "zephyr-andre.frozen",
      "steps": [
        {
          "fql": "FIND symbols WHERE fql_kind = 'comment' WHERE name LIKE '%west manifest file%' IN 'west.yml'",
          "assert": {
            "total": 1,
            "row_count": 1,
            "rows": [
              { "name": "# The west manifest file for upstream Zephyr.", "path": "west.yml", "line": 1 }
            ]
          }
        }
      ]
    },
    {
      "name": "yaml_nested_comment_owns_handle",
      "use": "zephyr-andre.frozen",
      "steps": [
        {
          "fql": "FIND symbols WHERE fql_kind = 'comment' WHERE name LIKE '%zephyr-keep-sorted-stop%' IN 'west.yml'",
          "assert": {
            "total": 1,
            "row_count": 1,
            "rows": [
              { "path": "west.yml", "line": 418 }
            ]
          }
        }
      ]
    },
    {
      "name": "yaml_comment_role_mention_is_recorded",
      "use": "zephyr-andre.frozen",
      "steps": [
        {
          "fql": "FIND usages OF 'alphabetical' WHERE role = 'comment' IN 'west.yml'",
          "assert": {
            "total": 1,
            "row_count": 1
          }
        }
      ]
    },
    {
      "name": "control_cpp_comment_rows_must_not_move",
      "use": "zephyr-andre.frozen",
      "steps": [
        {
          "fql": "FIND symbols WHERE fql_kind = 'comment' WHERE name = '/* CONFIG_PM_DEVICE_RUNTIME_ASYNC */' IN 'subsys/pm/device_runtime.c' ORDER BY line ASC LIMIT 30",
          "assert": {
            "row_count": 8,
            "rows": [
              { "path": "subsys/pm/device_runtime.c", "line": 29 },
              { "path": "subsys/pm/device_runtime.c", "line": 97 }
            ]
          }
        }
      ]
    },
    {
      "name": "control_c_file_comment_runs_now_group",
      "use": "zephyr-andre.frozen",
      "steps": [
        {
          "fql": "FIND symbols WHERE fql_kind = 'comment_block' IN 'subsys/pm/device_runtime.c'",
          "assert": {
            "total": 1,
            "row_count": 1,
            "rows": [
              { "path": "subsys/pm/device_runtime.c", "line": 573 }
            ]
          }
        }
      ]
    },
    {
      "name": "yaml_comment_run_becomes_one_block",
      "use": "zephyr-andre.frozen",
      "steps": [
        {
          "fql": "FIND symbols WHERE fql_kind = 'comment_block' IN 'west.yml' ORDER BY line ASC",
          "assert": {
            "total": 2,
            "row_count": 2,
            "rows": [
              { "path": "west.yml", "line": 1 }
            ]
          }
        }
      ]
    },
    {
      "name": "key_path_disambiguates_west_remote",
      "use": "zephyr-andre.frozen",
      "steps": [
        {
          "fql": "FIND symbols WHERE key_path = 'manifest.defaults.remote' IN 'west.yml'",
          "assert": {
            "total": 1,
            "row_count": 1,
            "rows": [
              { "name": "remote", "path": "west.yml", "line": 19 }
            ]
          }
        }
      ]
    },
    {
      "name": "twin_west_remote_pairs_without_key_path",
      "use": "zephyr-andre.frozen",
      "steps": [
        {
          "fql": "FIND symbols WHERE name = 'remote' WHERE fql_kind = 'pair' IN 'west.yml' ORDER BY line ASC LIMIT 60",
          "assert": {
            "row_count": 12,
            "rows": [
              { "name": "remote", "path": "west.yml", "line": 19 }
            ]
          }
        }
      ]
    },
    {
      "name": "key_path_finds_container_image_reference",
      "use": "zephyr-andre.frozen",
      "steps": [
        {
          "fql": "FIND symbols WHERE key_path LIKE 'jobs.%.container.image' IN '.github/workflows/clang.yaml'",
          "assert": {
            "total": 1,
            "row_count": 1,
            "rows": [
              { "name": "image", "path": ".github/workflows/clang.yaml", "line": 21 }
            ]
          }
        }
      ]
    },
    {
      "name": "twin_clang_image_pair_without_key_path",
      "use": "zephyr-andre.frozen",
      "steps": [
        {
          "fql": "FIND symbols WHERE name = 'image' IN '.github/workflows/clang.yaml'",
          "assert": {
            "total": 1,
            "row_count": 1,
            "rows": [
              { "name": "image", "path": ".github/workflows/clang.yaml", "line": 21 }
            ]
          }
        }
      ]
    },
    {
      "name": "blocked_comment_member_still_resolves_on_its_own",
      "use": "zephyr-andre.frozen",
      "steps": [
        {
          "fql": "FIND symbols WHERE fql_kind = 'comment_block' IN 'west.yml' ORDER BY line ASC",
          "assert": { "row_count": 2 },
          "capture": { "BLOCK": "results.0.node_id" }
        },
        {
          "fql": "SHOW NODE '${BLOCK}'",
          "assert": { "row_count": 15 }
        },
        {
          "fql": "FIND symbols WHERE fql_kind = 'comment' WHERE name LIKE '%west manifest file%' IN 'west.yml'",
          "assert": { "row_count": 1 },
          "capture": { "MEMBER": "results.0.node_id" }
        },
        {
          "fql": "SHOW NODE '${MEMBER}'",
          "assert": { "row_count": 1 }
        },
        {
          "fql": "SHOW NODE '${BLOCK}(1)'",
          "assert": { "row_count": 1 }
        },
        {
          "fql": "SHOW NODE '${BLOCK}(1-15)'",
          "assert": { "row_count": 15 }
        }
      ]
    },
    {
      "name": "control_json_blocks_arrays_not_comments",
      "use": "forgeql-pub.frozen",
      "steps": [
        {
          "fql": "FIND symbols WHERE fql_kind = 'array_block' IN 'crates/forgeql/tests/corpus.json'",
          "assert": {
            "total": 1,
            "row_count": 1,
            "rows": [
              { "path": "crates/forgeql/tests/corpus.json", "line": 2 }
            ]
          }
        },
        {
          "fql": "FIND symbols WHERE fql_kind = 'comment_block' IN 'crates/forgeql/tests/corpus.json'",
          "assert": { "total": 0, "row_count": 0 }
        }
      ]
    },
    {
      "name": "control_zephyr_kind_composition_is_stable",
      "use": "zephyr-andre.frozen",
      "steps": [
        {
          "fql": "FIND symbols GROUP BY fql_kind ORDER BY count DESC",
          "assert": {
            "row_count": 20,
            "rows": [
              { "kind": "number", "count": 534177 },
              { "kind": "variable", "count": 445100 },
              { "kind": "comment", "count": 295326 }
            ]
          }
        }
      ]
    }
  ]
}
