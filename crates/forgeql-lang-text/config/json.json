{
  "language": {
    "name": "json",
    "extensions": ["json", "jsonc"],
    "tree_sitter_grammar": "tree-sitter-json"
  },

  "syntax": {
    "root_node": "document",
    "skip_node_kinds": [],
    "mention_token_extra_chars": "-",
    "mention_text_kinds": {
      "string": { "role": "config", "when_field": "value" }
    }
  },

  "capabilities": {
    "has_goto": false,
    "has_increment_decrement": false,
    "has_implicit_truthiness": false,
    "params_share_body_scope": false
  },

  "kind_map": {
    "object":  "object",
    "array":   "array",
    "pair":    "pair",
    "comment": "comment"
  },

  "block_groups": [
    {
      "member_fql_kind": "array",
      "block_fql_kind": "array_block",
      "min_run": 8
    }
  ]
}